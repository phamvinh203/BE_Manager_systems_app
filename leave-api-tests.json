            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2019,\n  \"leaveType\": \"ANNUAL\",\n  \"totalDays\": 12\n}"
            },
            "description": "Test validation: năm phải từ 2020-2100"
          }
        },
        {
          "name": "Cập nhật balance - totalDays âm",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/leave/balance/1",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2026,\n  \"leaveType\": \"ANNUAL\",\n  \"totalDays\": -5\n}"
            },
            "description": "Test validation: totalDays phải là số không âm"
          }
        },
        {
          "name": "Xem đơn - ID không hợp lệ",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/leave/requests/0",
            "description": "Test validation: ID phải là số nguyên dương"
          }
        },
        {
          "name": "Query - status không hợp lệ",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/leave/requests?status=INVALID",
            "description": "Test validation: status phải là PENDING, APPROVED, REJECTED hoặc CANCELLED"
