generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  WFH
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  GENERAL
  REPORT
  TRAINING
  MEETING
  SYSTEM
}



model User {
 id        Int       @id @default(autoincrement())
 email     String    @unique
 fullName  String?  
 password  String?   @map("password")    
 isActive  Boolean   @default(true) @map("is_active")
 employee  Employee? 
 role      Role      @default(EMPLOYEE)
 createdAt DateTime  @default(now()) @map("created_at")
 updatedAt DateTime  @updatedAt @map("updated_at")

 @@map("users")
}


model Employee {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String?  @unique
  phone       String?
  salary      Float?
  status      String   @default("ACTIVE")
  hiredAt     DateTime @map("hired_at")

  departmentId Int?    @map("department_id")
  department   Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id])

  positionId   Int?    @map("position_id")
  position     Position? @relation(fields: [positionId], references: [id])

  // Relation cho manager
  managedDepartment Department? @relation("DepartmentManager")

  userId      Int?     @unique
  user        User?    @relation(fields: [userId], references: [id])
  attendances Attendance[]

  // Leave request relations
  leaveRequests    LeaveRequest[] @relation("EmployeeLeaveRequests")
  approvedRequests LeaveRequest[] @relation("LeaveApprover")
  leaveBalances    LeaveBalance[]

  // Task relations
  createdTasks     Task[]
  taskAssignments  TaskAssignment[]

  statusLogs        TaskStatusLog[]

  deletedAt DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("employees")
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  managerId Int?      @unique @map("manager_id")
  manager   Employee? @relation("DepartmentManager", fields: [managerId], references: [id])

  employees Employee[] @relation("DepartmentEmployees")
  positions Position[]

  tasks Task[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model Position {
  id           Int        @id @default(autoincrement())
  name         String
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])

  employees Employee[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, departmentId])
  @@map("positions")
}



model Attendance {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  checkIn     DateTime? @map("check_in")
  checkOut    DateTime? @map("check_out")
  totalHours  Float?    @map("total_hours")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([employeeId, date]) 
  @@index([date])
  @@index([employeeId])
  @@map("attendances")
}

model LeaveRequest {
  id          Int          @id @default(autoincrement())
  employeeId  Int          @map("employee_id")
  employee    Employee     @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id])

  leaveType   LeaveType
  startDate    DateTime     @map("from_date")
  endDate      DateTime     @map("to_date")
  totalDays   Float        @map("total_days")
  reason      String?

  status      LeaveStatus  @default(PENDING)

  approverId  Int?         @map("approver_id")
  approver    Employee?    @relation("LeaveApprover", fields: [approverId], references: [id])

  approvedAt  DateTime?    @map("approved_at")
  rejectedAt  DateTime?    @map("rejected_at")
  rejectNote  String?

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}


model LeaveBalance {
  id            Int       @id @default(autoincrement())
  employeeId    Int       @map("employee_id")
  employee      Employee  @relation(fields: [employeeId], references: [id])

  year          Int       // Năm áp dụng
  leaveType     LeaveType

  totalDays     Float     // Tổng số ngày được phép
  usedDays      Float     @default(0)  // Đã sử dụng
  pendingDays   Float     @default(0)  // Đang chờ duyệt

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, year, leaveType])
  @@index([employeeId])
  @@map("leave_balances")
}


model Task {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?

  departmentId  Int          @map("department_id")
  department    Department   @relation(fields: [departmentId], references: [id])

  createdById   Int          @map("created_by")
  createdBy     Employee     @relation(fields: [createdById], references: [id])

  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  type          TaskType     @default(GENERAL)

  startDate     DateTime?    @map("start_date")
  dueDate       DateTime?    @map("due_date")

  assignments   TaskAssignment[]
  statusLogs   TaskStatusLog[]

  deletedAt DateTime? @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([status])
  @@map("tasks")
}


model TaskAssignment {
  id          Int        @id @default(autoincrement())

  taskId      Int        @map("task_id")
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  employeeId  Int        @map("employee_id")
  employee    Employee   @relation(fields: [employeeId], references: [id])

  status      TaskStatus @default(TODO)
  progress    Int        @default(0)

  assignedAt  DateTime   @default(now()) @map("assigned_at")
  completedAt DateTime?  @map("completed_at")

  @@unique([taskId, employeeId])
  @@index([employeeId])
  @@map("task_assignments")
}

model TaskStatusLog {
  id           Int        @id @default(autoincrement())
  taskId       Int        @map("task_id")
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  changedById  Int        @map("changed_by")
  changedBy    Employee   @relation(fields: [changedById], references: [id])

  oldStatus    TaskStatus
  newStatus    TaskStatus

  changedAt    DateTime   @default(now()) @map("changed_at")

  @@index([taskId])
  @@map("task_status_logs")
}
